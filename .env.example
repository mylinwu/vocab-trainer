# Database
# For local development, use SQLite:
DATABASE_URL="file:./dev.db"

# For production — Vercel 不支持 SQLite，请使用以下方案之一：
# 1. Turso (libSQL，与 SQLite 语法兼容，推荐):
#    DATABASE_URL="libsql://your-db.turso.io?authToken=YOUR_TOKEN"
# 2. Vercel Postgres:
#    DATABASE_URL="postgres://..."
# 3. Neon / Supabase (PostgreSQL):
#    DATABASE_URL="postgresql://..."

# NextAuth
# Generate a secure secret: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret-at-least-32-characters"

# Vercel 部署时必须设为 true
AUTH_TRUST_HOST="true"

# Vercel 部署时取消注释并填入实际域名（NextAuth v5 推荐设置）
# AUTH_URL="https://your-app.vercel.app"
