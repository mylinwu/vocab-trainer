# Database
# Local development uses the SQLite file under prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Production uses Turso/libSQL because this Prisma schema is configured with provider = "sqlite".
# Option A: keep the token in the URL:
# DATABASE_URL="libsql://your-db.turso.io?authToken=YOUR_TOKEN"
#
# Option B: keep the token separate:
# DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="YOUR_TOKEN"
#
# Optional remote libSQL connection timeout.
LIBSQL_CONNECT_TIMEOUT_MS="30000"

# NextAuth
# Generate a secure secret: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret-at-least-32-characters"

# Required on Vercel.
AUTH_TRUST_HOST="true"

# Recommended on Vercel. Uncomment and set your real domain.
# AUTH_URL="https://your-app.vercel.app"
